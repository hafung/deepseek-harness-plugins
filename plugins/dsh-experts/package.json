{
  "name": "@local/dsh-experts",
  "version": "1.0.0",
  "private": true,
  "title": "专家",
  "description": "把常用角色与指令沉淀成专家，一键载入对话输入框。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "author": "hafung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hafung/deepseek-harness-plugins.git",
    "directory": "plugins/dsh-experts"
  },
  "homepage": "https://github.com/hafung/deepseek-harness-plugins/tree/main/plugins/dsh-experts#readme",
  "bugs": {
    "url": "https://github.com/hafung/deepseek-harness-plugins/issues"
  }
}
